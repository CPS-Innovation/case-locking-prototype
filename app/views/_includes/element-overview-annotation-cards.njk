{% set annotationGroups = { evidence: [], disclosure: [] } %}
{% for annotation in annotations %}
  {% if annotation.type == 'evidence' %}
    {% set noop = annotationGroups.evidence.push(annotation) %}
  {% else %}
    {% set noop = annotationGroups.disclosure.push(annotation) %}
  {% endif %}
{% endfor %}

{% macro overviewAnnotationCard(annotation, typeColour) %}
  <div class="app-review-annotation-card app-review-annotation-card--{{ typeColour }}">
    <div
      class="app-review-annotation-card__header app-annotation-card__tag--{{ typeColour }}"
    >
      <p class="govuk-!-margin-bottom-0">{{ annotation.caseReviewDocument.document.name }}</p>
      <p class="govuk-!-margin-bottom-0">
        <a
          href="/cases/{{ _case.id }}/review/documents/{{ annotation.caseReviewDocument.documentId }}#annotation-{{ annotation.id }}"
          class="govuk-link govuk-link--no-visited-state"
        >
          Change
          <span class="govuk-visually-hidden">annotation</span>
        </a>
      </p>
    </div>
    <div class="app-review-annotation-card__body">
      {% if annotation.selectedText == 'Whole photo' %}
        <img
          src="/public/images/evidence-photo-placeholder.jpg"
          alt="{{ annotation.caseReviewDocument.document.name }}"
          class="app-review-annotation-card__photo"
        />
      {% else %}
        {% if annotation.timestampSeconds != null %}
          {% if annotation.caseReviewDocument.document.type == 'MP3' %}
            <audio
              src="/public/audio/999-call-placeholder.mp3#t={{ annotation.timestampSeconds }}"
              class="app-review-annotation-card__audio"
              controls
            ></audio>
          {% else %}
            <video
              src="/public/videos/cctv-placeholder.mp4#t={{ annotation.timestampSeconds }}"
              class="app-review-annotation-card__video"
              controls
            ></video>
          {% endif %}
          <p class="app-review-annotation-card__label">Timestamp</p>
          <p>{{ annotation.selectedText }}</p>
        {% else %}
          <p>‘{{ annotation.selectedText | truncate(80) }}’</p>
        {% endif %}
      {% endif %}

      {% for link in annotation.elements %}
        {# Reason capture disabled — restore to re-enable:
        <p class="govuk-!-margin-bottom-{{ '0' if loop.last else '4' }}">{{ link.reasoning }}</p>
        #}
      {% endfor %}
    </div>
  </div>
{% endmacro %}

{% if annotations.length %}
  <div class="govuk-!-margin-bottom-6">
    {% if annotationGroups.evidence.length %}
      <div class="govuk-inset-text govuk-!-margin-top-0 app-inset-text--blue">
        <h4 class="govuk-heading-s govuk-!-margin-bottom-3">Evidence</h4>
        {% for annotation in annotationGroups.evidence %}
          {{ overviewAnnotationCard(annotation, 'blue') }}
        {% endfor %}
      </div>
    {% endif %}

    {% if annotationGroups.disclosure.length %}
      <div class="govuk-inset-text govuk-!-margin-top-0 app-inset-text--red">
        <h4 class="govuk-heading-s govuk-!-margin-bottom-3">Issues anticipated</h4>
        {% for annotation in annotationGroups.disclosure %}
          {{ overviewAnnotationCard(annotation, 'red') }}
        {% endfor %}
      </div>
    {% endif %}
  </div>
{% endif %}
