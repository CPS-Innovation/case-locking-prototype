<form
  method="post"
  action="/cases/{{ caseId }}/review-variant-2/material/documents/{{ documentId }}/annotations/add"
  class="js-annotation-form"
  hidden
>
  <input type="hidden" name="selectedText" class="js-annotation-selected-text" />
  <input type="hidden" name="type" class="js-annotation-type-hidden" />
  <input type="hidden" name="note" class="js-annotation-note-hidden" />
  <input type="hidden" name="timestampSeconds" class="js-annotation-timestamp-hidden" />
  <input type="hidden" name="selections" class="js-annotation-selections" />
</form>
